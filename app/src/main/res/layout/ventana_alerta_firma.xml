<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:windowSoftInputMode="adjustResize|stateHidden"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/signLayout"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints" />
    <Button
        android:id="@+id/limpiar_firma"
        android:layout_width="115dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="455dp"
        android:textColor="@color/white"
        android:text="Limpiar"
        />
    <Button
        android:id="@+id/veri_firma"
        android:layout_width="115dp"
        android:layout_height="40dp"
        android:layout_marginLeft="140dp"
        android:layout_marginTop="455dp"
        android:textColor="@color/rojo_infa"
        android:text="Verificar firma"
        />
    <Button
        android:id="@+id/salir_firma"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Salir"
        android:textColor="@color/white"
        android:layout_marginTop="455dp"
        android:layout_marginLeft="275dp"/>
    <TextView
        android:id="@+id/txt_msj_firma"
        android:layout_width="260dp"
        android:layout_height="40dp"
        android:text=""
        android:layout_marginLeft="150dp"
        android:layout_marginTop="300dp"
        android:textSize="15dp"
        android:textAlignment="center"
        />
    <TextView
        android:id="@+id/msj_intentos_firma"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:text=""
        android:layout_marginTop="300dp"
        android:textSize="15dp"
        android:textAlignment="center"
        />
    <TextView
        android:id="@+id/msj_intentos_fallidas"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:text="Ingrese sus datos"
        android:layout_marginTop="335dp"
        android:textSize="15dp"
        android:textAlignment="center"
        />
    <AutoCompleteTextView
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="ingresar nombre"
        android:id="@+id/nom_user_firma"
        android:layout_marginTop="360dp"
        />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="ingresar contraseña"
        android:id="@+id/pass_user_firma"
        android:layout_marginTop="405dp"
        android:inputType="textPassword"
        />
</FrameLayout>