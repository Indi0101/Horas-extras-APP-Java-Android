<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"

    tools:context=".Marcar_hora_entrada">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="60dp"
        android:text="Bienvenido"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="120dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginVertical="90dp"
        android:text="Inicie sesion"
        android:textAlignment="center"
        android:textColor="@android:color/tab_indicator_text"
        android:textSize="16sp"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/nigga"
        android:text="INFATLAN"
        android:textAlignment="center"
        android:textColor="@color/rojo_infa"
        android:textSize="25sp"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="5dp"
        tools:layout_editor_absoluteY="1dp" />

    <EditText
        android:id="@+id/correo_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="200dp"
        android:ems="10"
        android:hint="E-mail"
        android:inputType="textEmailAddress"
        android:textColor="@color/color_card_view"
         />

    <EditText
        android:id="@+id/contra_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="290dp"
        android:ems="10"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:textColor="@color/color_card_view" />

    <Button
        android:id="@+id/img_login"
        android:layout_width="180dp"
        android:layout_height="55dp"
        android:layout_below="@+id/contra_login"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Entrar"
        android:textSize="18sp"

        android:textColor="@color/color_card_view" />

    <ImageView
        android:id="@+id/img_error1_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="320dp"
        android:layout_marginVertical="210dp"
        app:srcCompat="@drawable/ic_baseline_error_outline_24" />

    <ImageView
        android:id="@+id/img_error2_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="320dp"
        android:layout_marginVertical="300dp"
        app:srcCompat="@drawable/ic_baseline_error_outline_24" />


</RelativeLayout>