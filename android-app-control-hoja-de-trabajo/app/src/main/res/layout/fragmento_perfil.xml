<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    android:background="@drawable/fondo"
    android:scrollbarAlwaysDrawHorizontalTrack="true">

    <TextView
        android:id="@+id/txt_lista"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="0dp"
        android:background="@color/nigga"
        android:text="Informacion del usuario"
        android:textAlignment="center"
        android:textSize="20dp"

        />

    <TextView
        android:id="@+id/nombre_emple_perfil"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="35dp"
        android:text="Indira Zaldivar H C"
        android:textAlignment="center"
        android:textColor="@color/color_card_view"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="80dp"
        android:text="Hora de entrada:"
        android:textAlignment="center"
        android:textColor="@color/color_card_view"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/hora_entrada_perfil"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="120dp"
        android:text="10:00:00 am"
        android:textAlignment="center"
        android:textColor="@color/color_card_view"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/textView10"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="130dp"
        android:textAlignment="center"
        android:layout_marginTop="260dp"
        android:text="Fecha"
        android:textColor="@color/nigga"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/textView7"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="290dp"
        android:textAlignment="center"
        android:layout_marginTop="260dp"
        android:text="Estado"
        android:textColor="@color/nigga"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginTop="260dp"
        android:text="N Peticion"
        android:textColor="@color/nigga"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="235dp"
        android:text="Lista de tareas finalizadas"
        android:textAlignment="center"
        android:textColor="@color/color_card_view"
        android:textSize="18sp" />
    <Button
        android:id="@+id/btn_salida_perfil"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="170dp"
        android:forceDarkAllowed="false"
        android:text="Marcar salida"
        android:textColor="@color/rojo_infa" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout_recycleView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="280dp"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recicle_view_perfil"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/nigga"
                android:scrollbars="horizontal" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:layout_marginTop="500dp"
        android:text="Lista de horas aprobadas"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/textView12"
        android:layout_width="100dp"
        android:layout_height="25dp"
        android:layout_marginTop="525dp"
        android:text="N Registro"
        android:textColor="@color/nigga"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/textView13"
        android:layout_width="108dp"
        android:layout_height="25dp"
        android:layout_marginLeft="130dp"
        android:textAlignment="center"
        android:layout_marginTop="525dp"
        android:text="Estado"
        android:textColor="@color/nigga"
        android:textSize="15sp" />
    <TextView
        android:id="@+id/textView14"
        android:layout_width="108dp"
        android:layout_height="25dp"
        android:layout_marginLeft="290dp"
        android:textAlignment="center"
        android:layout_marginTop="525dp"
        android:text="Pago"
        android:textColor="@color/nigga"
        android:textSize="15sp" />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout_listView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="550dp"
        >
    <ListView
        android:id="@+id/lista_perfil"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:textColor="@color/nigga"
        android:background="@color/nigga" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>