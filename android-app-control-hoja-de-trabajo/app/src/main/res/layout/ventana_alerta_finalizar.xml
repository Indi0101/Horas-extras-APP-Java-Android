                    tools:ignore="MissingConstraints" />

                <RadioButton
                    android:id="@+id/radio_trabajo_pendi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Queda trabajo pendiente"
                    tools:ignore="MissingConstraints" />

                <RadioButton
                    android:id="@+id/radio_no_resul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="No se resolvio"
                    tools:ignore="MissingConstraints" />
            </RadioGroup>

            <Button
