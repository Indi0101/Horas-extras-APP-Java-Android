<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@color/nigga"

    >

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="wrap_content"
        android:layout_height="69dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/nigga_l"
        app:cardCornerRadius="10dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/card_txt_estdo"
            android:layout_width="60dp"
            android:layout_height="20dp"
            android:layout_marginVertical="31dp"
            android:layout_marginLeft="20dp"
            android:text="Estado :" />

        <TextView
            android:id="@+id/card_estdo"
            android:layout_width="110dp"
            android:layout_height="20dp"
            android:layout_marginVertical="31dp"
            android:layout_marginLeft="85dp"
            android:text="Disponible"
            android:textColor="@color/color_card_view" />


        <TextView
            android:id="@+id/card_txt_peticion"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="5dp"
            android:text="Numero de peticion:"

            />

        <TextView
            android:id="@+id/card_peticion"
            android:layout_width="33dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="165dp"
            android:layout_marginVertical="5dp"
            android:textColor="@color/color_card_view" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="48dp"
            android:layout_height="41dp"
            android:layout_marginHorizontal="330dp"
            android:layout_marginVertical="8dp"
            app:srcCompat="@drawable/next" />


    </androidx.cardview.widget.CardView>


</RelativeLayout>