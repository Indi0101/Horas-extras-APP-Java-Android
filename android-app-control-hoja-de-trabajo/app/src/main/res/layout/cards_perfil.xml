<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="60dp"
    android:background="@color/nigga"
    >
    <androidx.cardview.widget.CardView
        android:layout_height="50dp"
        android:layout_width="match_parent"
        android:id="@+id/card_perfil"
        android:background="@color/nigga_l"
        android:layout_margin="2dp"
        app:cardCornerRadius="2dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/id_peticion_card_perfil"
            android:layout_width="58dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp" />

        <TextView
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:layout_marginHorizontal="150dp"
            android:id="@+id/fecha_card_perfil"
            />
        <TextView
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_marginTop="5dp"
            android:textAlignment="center"
            android:layout_marginHorizontal="290dp"
            android:id="@+id/estado_card_perfil"
            />
    </androidx.cardview.widget.CardView>



</FrameLayout>